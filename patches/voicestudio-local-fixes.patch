+def _configure_rocm_windows() -> None:
+    """ROCm on Windows: PyTorch's own convolutions instead of MIOpen's, and
+    AOTriton attention, as the backend does (services/model_manager.py).
+    MIOpen tunes every new input shape for minutes. OMNIVOICE_MIOPEN=1 keeps it.
+
+    Also run by the venv probe (bootstrap.py) before it imports indextts: a
+    probe that fails here makes the backend bootstrap a CUDA venv of its own,
+    which runs on the CPU.
+    """
+    if sys.platform != "win32":
+        return
+    import importlib.util
+
+    if importlib.util.find_spec("torch") is None:
+        return
+    import torch
+
+    if getattr(torch.version, "hip", None) is None:
+        return
+    os.environ.setdefault("TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL", "1")
+    if os.environ.get("OMNIVOICE_MIOPEN") != "1":
+        torch.backends.cudnn.enabled = False
+    # TorchScript's fuser compiles bf16 kernels that corrupt the heap here (the
+    # s2mel wavenet's scripted gate; 0xC0000374). The ops run unfused instead.
+    torch._C._jit_set_texpr_fuser_enabled(False)
+    if not torch.distributed.is_available():
+        # This torch has no distributed backend. transformers 4.52 (IndexTTS's
+        # pin) imports torch.distributed.tensor unguarded, and audiotools (s2mel)
+        # names dist.ReduceOp.AVG as a default argument. Their other uses check
+        # that distributed is available first.
+        import enum
+        import types
+
+        sys.modules.setdefault("torch.distributed.tensor", types.ModuleType("torch.distributed.tensor"))
+        if not hasattr(torch.distributed, "ReduceOp"):
+            torch.distributed.ReduceOp = enum.Enum("ReduceOp", "SUM AVG PRODUCT MIN MAX")
+
+
+def _rocm_reduced_precision_s2mel(model) -> None:
+    """ROCm on Windows: run s2mel's diffusion under the GPT's reduced precision.
+
+    Upstream runs it in fp32, which takes a consumer Radeon 4-5x as long as
+    bf16 (some 40 s a line); the output differs by about 0.3%. The ODE state
+    stays fp32. With OMNIVOICE_INDEXTTS_FP16=0 the model has no reduced
+    precision and this keeps fp32.
+    """
+    import torch
+
+    dtype = getattr(model, "dtype", None)
+    if sys.platform != "win32" or getattr(torch.version, "hip", None) is None or dtype is None:
+        return
+    cfm = model.s2mel.models["cfm"]
+    inference = cfm.inference
+
+    def reduced(*args, **kwargs):
+        with torch.amp.autocast("cuda", dtype=dtype):
+            return inference(*args, **kwargs).float()
+
+    cfm.inference = reduced
+
+
