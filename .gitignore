# Source media, per-show work and renders stay local: copyrighted material,
# transcripts and references to real people's voices.
videos/
work/
dubbed/

# Source media, voice references and subtitles can also be generated elsewhere.
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.srt
*.vtt

__pycache__/
*.pyc
.venv/

# Local .NET build products for media-server plugins.
integrations/**/bin/
integrations/**/obj/

# Third-party code fetched at setup (vc.py: Chatterbox).
vendor/
