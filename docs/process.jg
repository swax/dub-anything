   "bounds": {
    "x": 530,
    "y": 1200,
    "width": 440,
    "height": 210
   },
   "label": "<part>/script.json  ·  the directed part\nper line: start · end · voice\nja (or en, es…): the corrected original\ntext: the dub · optional: text_us, listen…\ncaptions: speech kept in the original\nsigns: text in the picture, translated\n\"ready\": true  →  it renders",
   "shape": "document",
   "nodeColor": "#00897B",
   "labelColor": "#ffffff",
   "parentId": "g4"
  },
