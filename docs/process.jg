  {
   "id": "subtitle",
   "bounds": {
    "x": 0,
    "y": -190,
    "width": 1000,
    "height": 110
   },
   "label": "Video dubbing in each speaker's voice, with the original music and effects.\nMachines separate, transcribe, clone and mix. The director, an AI agent, decides the\ntranscript, casting, translation and timing. Japanese, Spanish, Korean and Chinese\ninto English; English into Japanese and Spanish.",
   "shape": "text",
   "labelColor": "#ECEFF1"
  },
  {
   "id": "local-note",
   "bounds": {
    "x": 1160,
    "y": -190,
    "width": 480,
    "height": 80
   },
   "label": "Runs locally on your GPU. videos/ and work/ are\ngit-ignored for source media, transcripts and voice\nreferences. Keep production details out of commits.",
   "shape": "text",
   "labelColor": "#ECEFF1"
  },
